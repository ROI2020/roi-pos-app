# Configuración para scripts/backup-prod.ps1
# Copiar a secrets/.env.bck.prod y completar con valores reales.
# NUNCA commitear el archivo con valores.

# URL del Session Pooler de PROD (puerto 5432, NO el Transaction Pooler 6543)
DATABASE_URL_PROD=

# Ruta a los binarios de PostgreSQL (pg_dump, pg_restore, psql)
PG_BIN=C:\Program Files\PostgreSQL\16\bin

# Carpeta donde se guardan los backups
BACKUP_DIR=C:\apps\roipos\roipos-bck
