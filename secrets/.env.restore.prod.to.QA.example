# Configuración para scripts/restaurar-qa.ps1
# Copiar a secrets/.env.restore.prod.to.QA y completar con valores reales.
# NUNCA commitear el archivo con valores.

# URL del Session Pooler de QA (puerto 5432)
DATABASE_URL_QA=

# Project ref de QA en Supabase (OBLIGATORIO, sin default).
# Es el ID de 20 letras que aparece en la URL de conexión (postgres.<ref>@...)
# y en Supabase › Project Settings › General › Project ID.
# NO es el nombre del proyecto ("roipos-qa").
QA_PROJECT_REF=

# Ruta a los binarios de PostgreSQL (pg_dump, pg_restore, psql).
# La versión tiene que ser igual o mayor a la de Postgres de Supabase
# (verificar con SHOW server_version; en la base).
PG_BIN=C:\Program Files\PostgreSQL\16\bin

# Carpeta donde están los backups de PROD (misma que en .env.bck.prod)
BACKUP_DIR=C:\apps\roipos\roipos-bck

# (Opcional) Carpeta para backups de QA; por defecto ..\QA hermana de BACKUP_DIR
# BACKUP_DIR_QA=C:\apps\roipos\roipos-bck\QA
