# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# esquema de db — los SQL de migración NO se versionan / Se pasan a mano en local y en producción
/database
/db

# documentación — la documentación generada no va al repo
/docs

# storage - Facturas PDF generadas no van al repo
/storage

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# netlify build cache
.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts

# Certificados ARCA — la clave privada nunca va al repo
/certs/roisol.key
/certs/*.p12
/certs/*.pfx